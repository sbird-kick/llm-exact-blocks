  },
  {
   "code": "F2",
   "name": "imperative",
   "desc": "an instruction, not a question (\"Work out / Find / Calculate how many ...\")"
  },
  {
   "code": "F3",
   "name": "conditional",
   "desc": "a conditional or hypothetical question (\"If ..., how many ...?\"); the condition adds no number and no step"
  },
  {
   "code": "F4",
   "name": "indirect",
